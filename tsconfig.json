{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true, // Habilita todas as verificações de tipo estritas.
    "noImplicitAny": true, // Gera erro quando o tipo "any" é implicitamente inferido.
    "allowUmdGlobalAccess": true, // Permite o acesso global a módulos UMD (Universal Module Definition) no TypeScript.
    "baseUrl": "./src/",
    "jsx": "react-jsx",
    "forceConsistentCasingInFileNames": true, // Gera erro se houver inconsistências de maiúsculas e minúsculas nos nomes dos arquivos.
    "paths": {
      "@/*": ["./src/*"], // Mapeia a pasta src
      "@assets/*": ["../assets/*"] // Mapeia a pasta assets
    }
  },
  "include": ["src", "app.d.ts"] // Inclui o arquivo app.d.ts
}
